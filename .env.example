# Ambiente local
NODE_ENV=development
PORT=3000

# Necessário somente para testar o webhook sandbox.
# Gere um valor longo e aleatório; nunca versione o arquivo .env.
NEVOA_WEBHOOK_SECRET=

# WhatsApp Cloud API (nunca envie estes valores pelo chat nem os versione).
# No Railway, use o caminho de um Volume persistente para o banco.
NEVOA_DB_PATH=/data/nevoa.db
PUBLIC_BASE_URL=https://seu-dominio-publico
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
